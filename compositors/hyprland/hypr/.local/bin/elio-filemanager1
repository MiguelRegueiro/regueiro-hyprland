#!/usr/bin/env python3
"""Temporary FileManager1 adapter until elio provides it natively.

Browsers use this D-Bus interface for "Show in folder".  elio's normal CLI
already focuses a path, so this adapter only converts the D-Bus URI into the
equivalent Kitty command.
"""

import os
import signal
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib


BUS_NAME = "org.freedesktop.FileManager1"
OBJECT_PATH = "/org/freedesktop/FileManager1"
INTERFACE_XML = """<node>
  <interface name="org.freedesktop.FileManager1">
    <method name="ShowFolders">
      <arg name="uris" type="as" direction="in"/>
      <arg name="startup_id" type="s" direction="in"/>
    </method>
    <method name="ShowItems">
      <arg name="uris" type="as" direction="in"/>
      <arg name="startup_id" type="s" direction="in"/>
    </method>
    <method name="ShowItemProperties">
      <arg name="uris" type="as" direction="in"/>
      <arg name="startup_id" type="s" direction="in"/>
    </method>
  </interface>
</node>"""
children = []


def process_group_exists(pgid):
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def launch(uri):
    file = Gio.File.new_for_uri(uri)
    path = file.get_path()
    if path is None:
        return
    children[:] = [child for child in children if process_group_exists(child.pid)]
    try:
        child = subprocess.Popen(
            ["kitty", "-e", "elio", path],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        print(f"elio-filemanager1: could not launch Kitty: {error}", file=sys.stderr)
        return
    children.append(child)


def on_method_call(connection, sender, object_path, interface_name, method_name,
                   parameters, invocation):
    uris, _startup_id = parameters.unpack()
    for uri in uris:
        launch(uri)
    invocation.return_value(None)


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    interface = Gio.DBusNodeInfo.new_for_xml(INTERFACE_XML).interfaces[0]
    bus.register_object(OBJECT_PATH, interface, on_method_call)
    loop = GLib.MainLoop()
    for signum in (signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, lambda _signum, _frame: loop.quit())

    def name_lost(connection, name):
        print(f"elio-filemanager1: could not own {name}", file=sys.stderr)
        loop.quit()

    Gio.bus_own_name_on_connection(
        bus, BUS_NAME, Gio.BusNameOwnerFlags.NONE, None, name_lost
    )
    try:
        loop.run()
    finally:
        stop_launched_terminals()


def stop_launched_terminals():
    active = [child for child in children if process_group_exists(child.pid)]
    for child in active:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    deadline = time.monotonic() + 2
    while time.monotonic() < deadline and any(
        process_group_exists(child.pid) for child in active
    ):
        time.sleep(0.05)

    for child in active:
        if process_group_exists(child.pid):
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    for child in active:
        child.wait()


if __name__ == "__main__":
    main()
