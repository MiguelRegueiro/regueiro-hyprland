#!/bin/sh
set -u

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 SESSION_PID COMMAND [ARG ...]" >&2
    exit 2
fi
session_pid=$1
shift
case "$session_pid" in ''|*[!0-9]*) echo "Invalid session PID" >&2; exit 2 ;; esac
kill -0 "$session_pid" 2>/dev/null || exit 0

"$@" &
command_pid=$!
(
    while kill -0 "$session_pid" 2>/dev/null && kill -0 "$command_pid" 2>/dev/null; do
        sleep 1
    done
    if ! kill -0 "$session_pid" 2>/dev/null; then
        kill -TERM "$command_pid" 2>/dev/null || exit 0
        sleep 3
        kill -KILL "$command_pid" 2>/dev/null || true
    fi
) &
watcher_pid=$!

cleanup() {
    trap - 0 HUP INT TERM
    kill -TERM "$command_pid" "$watcher_pid" 2>/dev/null || true
    wait "$command_pid" 2>/dev/null || true
    wait "$watcher_pid" 2>/dev/null || true
}
trap cleanup 0
trap 'exit 0' HUP INT TERM

wait "$command_pid"
status=$?
if ! kill -0 "$session_pid" 2>/dev/null; then
    status=0
fi
kill "$watcher_pid" 2>/dev/null || true
wait "$watcher_pid" 2>/dev/null || true
trap - 0 HUP INT TERM
exit "$status"
