#!/bin/sh
set -eu

repo_dir=${TRITON_DESKTOP_DIR:-}
if [ -z "$repo_dir" ] || [ ! -f "$repo_dir/desktop/platforms/src/freebsd/triton-freebsd-hardware.c" ]; then
    echo "TRITON_DESKTOP_DIR must point to the Triton Desktop checkout" >&2
    exit 1
fi

mkdir -p "$HOME/.local/bin"
output=${TRITON_HARDWARE_OUTPUT:-$HOME/.local/bin/triton-freebsd-hardware}
exec cc -O2 -pipe -std=c11 -Wall -Wextra -Werror \
    -o "$output" \
    "$repo_dir/desktop/platforms/src/freebsd/triton-freebsd-hardware.c"
