#!/bin/sh
set -eu

usage() {
    printf '%s\n' "Usage: ${0##*/} {reboot|poweroff}" >&2
    exit 2
}

action=${1:-}
[ "$#" -eq 1 ] || usage

case "$action" in
    reboot)
        exec doas -n /usr/local/libexec/triton-privileged system reboot
        ;;
    poweroff)
        exec doas -n /usr/local/libexec/triton-privileged system poweroff
        ;;
    *)
        usage
        ;;
esac
