#!/bin/sh
set -u

control=${TRITON_CONTROL_BIN:-$HOME/.local/bin/triton-control}
[ -x "$control" ] || exit 0

# The GTK application is single-instance. Adopt it when it was opened before
# autostart; otherwise start the tray instance hidden.
command -v pgrep >/dev/null 2>&1 || {
    echo "triton-connect-session: pgrep is required to supervise the tray app" >&2
    exit 1
}
app_pid=$(pgrep -u "$(id -u)" -x triton-control 2>/dev/null | sed -n '1p' || true)
started_app=false
if [ -z "$app_pid" ]; then
    "$control" --background &
    app_pid=$!
    started_app=true
fi

shutdown_host() {
    command -v python3 >/dev/null 2>&1 || return 0
    python3 - "${XDG_RUNTIME_DIR:-/tmp}/triton-connect/control.sock" <<'PY'
import socket
import sys
import time

for attempt in range(3):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
            stream.settimeout(0.25)
            stream.connect(sys.argv[1])
            stream.sendall(b'{"command":"shutdown"}\n')
            stream.recv(4096)
        break
    except OSError:
        if attempt < 2:
            time.sleep(0.15)
PY
}

cleanup() {
    trap - 0 HUP INT TERM
    shutdown_host
    if kill -0 "$app_pid" 2>/dev/null; then
        kill -TERM "$app_pid" 2>/dev/null || true
        attempt=0
        while kill -0 "$app_pid" 2>/dev/null && [ "$attempt" -lt 10 ]; do
            sleep 0.1
            attempt=$((attempt + 1))
        done
    fi
    if [ "${started_app:-false}" = true ]; then
        wait "$app_pid" 2>/dev/null || true
    fi
}
trap cleanup 0
trap 'exit 0' HUP INT TERM

while kill -0 "$app_pid" 2>/dev/null; do
    sleep 1
done
