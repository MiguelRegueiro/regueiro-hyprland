#!/bin/sh
set -u

# MimeClip is session-owned; neither systemd nor Linux-specific setsid is
# required. The pid directory prevents duplicate supervisors when Hyprland's
# delayed autostart commands race or this launcher is invoked again.
if [ "${1:-}" = "--supervise" ]; then
    daemon=$2
    resolver=$3
    log_file=$4
    lock_dir=$5
    session_pid=${6:-}
    daemon_pid=
    session_watch_pid=
    health_interval=${TRITON_MIMECLIP_HEALTH_INTERVAL:-30}
    health_timeout=${TRITON_MIMECLIP_HEALTH_TIMEOUT:-2}
    health_failures=${TRITON_MIMECLIP_HEALTH_FAILURES:-3}
    stop_timeout=${TRITON_MIMECLIP_STOP_TIMEOUT:-5}

    valid_positive_integer() {
        case "$1" in ''|*[!0-9]*|0) return 1 ;; esac
    }
    valid_positive_integer "$health_interval" || health_interval=30
    valid_positive_integer "$health_timeout" || health_timeout=2
    valid_positive_integer "$health_failures" || health_failures=3
    valid_positive_integer "$stop_timeout" || stop_timeout=5

    stop_daemon() {
        [ -n "$daemon_pid" ] || return 0
        child_pid=$(cat "$lock_dir/daemon-pid" 2>/dev/null || true)
        case "$child_pid" in ''|*[!0-9]*) child_pid= ;; esac
        [ ! -f "$lock_dir/daemon-exit" ] || child_pid=
        [ -z "$child_pid" ] || kill -TERM "$child_pid" 2>/dev/null || true
        kill -TERM "$daemon_pid" 2>/dev/null || true
        (
            timer_sleep_pid=
            trap 'kill "$timer_sleep_pid" 2>/dev/null || true; exit 0' HUP INT TERM
            sleep "$stop_timeout" &
            timer_sleep_pid=$!
            wait "$timer_sleep_pid" || exit 0
            [ -z "$child_pid" ] || kill -KILL "$child_pid" 2>/dev/null || true
            kill -KILL "$daemon_pid" 2>/dev/null || true
        ) &
        stop_timer_pid=$!
        wait "$daemon_pid" 2>/dev/null || true
        kill "$stop_timer_pid" 2>/dev/null || true
        wait "$stop_timer_pid" 2>/dev/null || true
        daemon_pid=
    }

    bounded_ping() {
        "$resolver" client ping >/dev/null 2>&1 &
        ping_pid=$!
        (
            timer_sleep_pid=
            trap 'kill "$timer_sleep_pid" 2>/dev/null || true; exit 0' HUP INT TERM
            sleep "$health_timeout" &
            timer_sleep_pid=$!
            wait "$timer_sleep_pid" || exit 0
            kill -TERM "$ping_pid" 2>/dev/null || exit 0
            sleep 1 &
            timer_sleep_pid=$!
            wait "$timer_sleep_pid" || exit 0
            kill -KILL "$ping_pid" 2>/dev/null || true
        ) &
        ping_timer_pid=$!
        ping_status=0
        wait "$ping_pid" || ping_status=$?
        kill "$ping_timer_pid" 2>/dev/null || true
        wait "$ping_timer_pid" 2>/dev/null || true
        return "$ping_status"
    }

    cleanup() {
        trap - 0 HUP INT TERM
        stop_daemon
        if [ -n "$session_watch_pid" ]; then
            kill "$session_watch_pid" 2>/dev/null || true
            wait "$session_watch_pid" 2>/dev/null || true
        fi
        if [ "$(cat "$lock_dir/pid" 2>/dev/null || true)" = "$$" ]; then
            rm -rf "$lock_dir"
        fi
    }
    trap cleanup 0
    trap 'exit 0' HUP INT TERM
    printf '%s\n' "$$" >"$lock_dir/pid"
    if [ -n "$session_pid" ]; then
        printf '%s\n' "$session_pid" >"$lock_dir/session-pid"
    fi
    delay=2
    while :; do
        if [ -n "$session_pid" ] && ! kill -0 "$session_pid" 2>/dev/null; then
            exit 0
        fi

        started_at=$(date +%s)
        rm -f "$lock_dir/daemon-pid" "$lock_dir/daemon-exit"
        (
            "$daemon" >>"$log_file" 2>&1 &
            child_pid=$!
            printf '%s\n' "$child_pid" >"$lock_dir/daemon-pid"
            trap 'kill -TERM "$child_pid" 2>/dev/null || true; wait "$child_pid" 2>/dev/null || true; exit 143' HUP INT TERM
            daemon_status=0
            wait "$child_pid" || daemon_status=$?
            printf '%s\n' "$daemon_status" >"$lock_dir/daemon-exit"
            exit "$daemon_status"
        ) &
        daemon_pid=$!
        failures=0
        if [ -n "$session_pid" ]; then
            supervisor_pid=$$
            (
                while kill -0 "$session_pid" 2>/dev/null; do sleep 1; done
                child_pid=$(cat "$lock_dir/daemon-pid" 2>/dev/null || true)
                case "$child_pid" in ''|*[!0-9]*) child_pid= ;; esac
                [ -z "$child_pid" ] || kill -TERM "$child_pid" 2>/dev/null || true
                kill -TERM "$supervisor_pid" 2>/dev/null || true
            ) &
            session_watch_pid=$!
        fi
        while [ ! -f "$lock_dir/daemon-exit" ]; do
            sleep "$health_interval" &
            health_sleep_pid=$!
            wait "$health_sleep_pid" 2>/dev/null || true
            [ ! -f "$lock_dir/daemon-exit" ] || break
            if bounded_ping; then
                failures=0
            else
                failures=$((failures + 1))
                if [ "$failures" -ge "$health_failures" ]; then
                    echo "MimeClip health check failed $failures consecutive times; restarting daemon." >&2
                    stop_daemon
                    break
                fi
            fi
        done
        if [ -n "$daemon_pid" ]; then
            wait "$daemon_pid" 2>/dev/null || true
            daemon_pid=
        fi
        stopped_at=$(date +%s)
        runtime=$((stopped_at - started_at))
        if [ -n "$session_watch_pid" ]; then
            kill "$session_watch_pid" 2>/dev/null || true
            wait "$session_watch_pid" 2>/dev/null || true
            session_watch_pid=
        fi
        rm -f "$lock_dir/daemon-pid" "$lock_dir/daemon-exit"
        if [ -n "$session_pid" ] && ! kill -0 "$session_pid" 2>/dev/null; then
            exit 0
        fi

        # A failed health check is already a reason to restart. Give a
        # recovered daemon the normal restart backoff if it exits later.

        # A daemon that stayed healthy for a while has recovered; don't keep
        # imposing the maximum backoff after a later, isolated crash.
        if [ "$runtime" -ge 60 ]; then
            delay=2
        fi
        if [ "$delay" -lt 30 ]; then
            delay=$((delay * 2))
            [ "$delay" -le 30 ] || delay=30
        fi
        waited=0
        while [ "$waited" -lt "$delay" ]; do
            if [ -n "$session_pid" ] && ! kill -0 "$session_pid" 2>/dev/null; then
                exit 0
            fi
            sleep 1
            waited=$((waited + 1))
        done
    done
fi

session_pid=
if [ "${1:-}" = "--session-pid" ]; then
    [ "$#" -eq 2 ] || { echo "Usage: $0 [--session-pid PID]" >&2; exit 2; }
    session_pid=$2
    case "$session_pid" in ''|*[!0-9]*) echo "Invalid session PID" >&2; exit 2 ;; esac
    kill -0 "$session_pid" 2>/dev/null || exit 0
elif [ "$#" -gt 0 ]; then
    echo "Usage: $0 [--session-pid PID]" >&2
    exit 2
fi

resolver="$HOME/.local/bin/triton-mimeclip"
[ -x "$resolver" ] || exit 0
daemon=$("$resolver" resolve daemon 2>/dev/null || true)
[ -x "$daemon" ] || exit 0

# Bound the health check even if the client is stuck waiting on a broken
# daemon. The watcher only touches this short-lived child process.
TRITON_MIMECLIP_HEALTH_TIMEOUT=${TRITON_MIMECLIP_HEALTH_TIMEOUT:-2}
case "$TRITON_MIMECLIP_HEALTH_TIMEOUT" in ''|*[!0-9]*|0) TRITON_MIMECLIP_HEALTH_TIMEOUT=2 ;; esac
"$resolver" client ping >/dev/null 2>&1 &
ping_pid=$!
(
    timer_sleep_pid=
    trap 'kill "$timer_sleep_pid" 2>/dev/null || true; exit 0' HUP INT TERM
    sleep "$TRITON_MIMECLIP_HEALTH_TIMEOUT" &
    timer_sleep_pid=$!
    wait "$timer_sleep_pid" || exit 0
    kill -TERM "$ping_pid" 2>/dev/null || exit 0
    sleep 1 &
    timer_sleep_pid=$!
    wait "$timer_sleep_pid" || exit 0
    kill -KILL "$ping_pid" 2>/dev/null || true
) &
ping_timer=$!
ping_status=0
wait "$ping_pid" || ping_status=$?
kill "$ping_timer" 2>/dev/null || true
wait "$ping_timer" 2>/dev/null || true
if [ "$ping_status" -eq 0 ]; then
    exit 0
fi

uid=$(id -u)
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    lock_dir=$XDG_RUNTIME_DIR/triton-mimeclip-$uid
else
    # Never create a predictable per-user lock directly under shared /tmp.
    # The cache fallback is owned by this user and private to this account.
    runtime_dir=${XDG_CACHE_HOME:-$HOME/.cache}/triton-mimeclip
    (umask 077; mkdir -p "$runtime_dir")
    chmod 700 "$runtime_dir"
    lock_dir=$runtime_dir/supervisor
fi
log_file="${XDG_CACHE_HOME:-$HOME/.cache}/mimeclipd.log"
mkdir -p "$(dirname "$log_file")"

if ! mkdir -m 700 "$lock_dir" 2>/dev/null; then
    # Allow the creator time to publish its pid before deciding the lock is
    # stale (for example, after a forced session termination).
    attempt=0
    while [ "$attempt" -lt 10 ] && [ ! -s "$lock_dir/pid" ]; do
        sleep 0.1
        attempt=$((attempt + 1))
    done
    if [ -s "$lock_dir/pid" ] && kill -0 "$(cat "$lock_dir/pid")" 2>/dev/null; then
        exit 0
    fi
    [ ! -L "$lock_dir" ] || exit 1
    rm -rf "$lock_dir"
    mkdir -m 700 "$lock_dir" 2>/dev/null || exit 0
fi

nohup "$0" --supervise "$daemon" "$resolver" "$log_file" "$lock_dir" "$session_pid" \
    </dev/null >/dev/null 2>&1 &
exit 0
