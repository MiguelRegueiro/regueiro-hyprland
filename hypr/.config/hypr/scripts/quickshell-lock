#!/usr/bin/env bash
set -euo pipefail

# Resolve through Stow, so new locker files work without restowing ~/.config.
self="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(dirname "$self")"
repo_root="$(cd "$script_dir/../../../.." && pwd)"
config="$repo_root/quickshell/.config/quickshell/lock.qml"
runtime_dir="${XDG_RUNTIME_DIR:?A running Wayland session is required}"
display="${WAYLAND_DISPLAY:?A running Wayland session is required}"

is_secure() {
    [[ "$(qs ipc -p "$config" call lock isSecure 2>/dev/null)" == "true" ]]
}

case "${1:-lock}" in
    --wait)
        if is_secure; then exit 0; fi
        nohup "$self" </dev/null >/dev/null 2>&1 &
        # Suspend is allowed only after compositor acknowledgement, never
        # because a process happens to exist or a fixed delay elapsed.
        for ((attempt = 0; attempt < 100; attempt++)); do
            if is_secure; then exit 0; fi
            sleep 0.1
        done
        echo "Lock could not be confirmed; refusing to suspend." >&2
        exit 1
        ;;
    lock) ;;
    *) echo "Usage: $0 [--wait]" >&2; exit 2 ;;
esac

exec 9>"$runtime_dir/quickshell-lock-${display##*/}.lock"
flock -n 9 || exit 0
is_secure && exit 0

# Passwords must never be written into core dumps or handed to an external IME.
ulimit -c 0
# Retry transient graphics failures without clearing the compositor lock.
# Stop after three failures to avoid an unbounded crash/restart loop.
for ((attempt = 1; attempt <= 3; attempt++)); do
    status=0
    QT_IM_MODULE=compose qs -n -p "$config" || status=$?
    if [[ "$status" == 42 ]]; then
        exit 0
    fi
    echo "Quickshell locker exited unexpectedly (attempt $attempt of 3)." >&2
    if ((attempt < 3)); then sleep 0.5; fi
done
echo "Locker could not recover. The compositor lock has not been cleared." >&2
exit 1
