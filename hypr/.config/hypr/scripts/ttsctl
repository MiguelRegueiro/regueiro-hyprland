#!/usr/bin/env bash

# Submit the current Wayland clipboard to the always-running EasyTTS server.
# The server owns generation/playback; this command only starts a job and exits.
set -euo pipefail

state_root="${XDG_RUNTIME_DIR:-/tmp/regueiro-$(id -u)}/regueiro-easytts"
state_file="$state_root/state.json"
media_player_file="$state_root/media-player"

server_host() {
    if [[ -n "${EASYTTS_HOST:-}" ]]; then
        printf '%s\n' "$EASYTTS_HOST"
    else
        # The server starts locally with this Hyprland session. Remote servers
        # remain supported through EASYTTS_HOST, without spawning tailscale for
        # every status refresh.
        printf '%s\n' "127.0.0.1"
    fi
}

notify_shell() {
    command -v qs >/dev/null 2>&1 || return 0
    qs ipc call tts refresh >/dev/null 2>&1 &
}

status() {
    local host port
    host="$(server_host)"
    port="${EASYTTS_PORT:-8765}"
    [[ -n "$host" ]] || host="127.0.0.1"
    curl --fail --silent --max-time 2 "http://${host}:${port}/api/status" \
        || { [[ -f "$state_file" ]] && cat "$state_file" || printf '%s\n' '{"state":"idle","text":"","detail":"","position":0,"duration":0}'; }
}

speak_clipboard() {
    local copied host port provider voice rate
    # With no explicit arguments (the F7 binding), let the service use its
    # saved selection instead of silently forcing its old command defaults.
    notify_shell
    provider="${1:-}"
    voice="${2:-}"
    rate="${3:-}"
    # F7 always replaces whatever TTS was doing (generating, playing, or
    # paused) with freshly generated clipboard speech.  The server cancels the
    # old job atomically before starting the new one.
    copied="$(wl-paste --no-newline 2>/dev/null || true)"
    if [[ -z "$copied" ]]; then
        mkdir -p "$state_root"
        printf '%s\n' '{"state":"error","text":"","detail":"Clipboard is empty"}' > "$state_file"
        exit 1
    fi
    host="$(server_host)"
    port="${EASYTTS_PORT:-8765}"
    if [[ -z "$host" ]]; then
        host="127.0.0.1"
    fi
    if ! printf '%s' "$copied" | python3 -c 'import json, sys; payload = {"text": sys.stdin.read()}; payload.update({key: value for key, value in (("provider", sys.argv[1]), ("voice", sys.argv[2]), ("rate", sys.argv[3])) if value}); print(json.dumps(payload))' "$provider" "$voice" "$rate" \
        | curl --fail --silent --show-error --max-time 5 \
            -H 'Content-Type: application/json' \
            --data-binary @- "http://${host}:${port}/api/speak" >/dev/null; then
        mkdir -p "$state_root"
        printf '%s\n' '{"state":"error","text":"","detail":"EasyTTS is not reachable"}' > "$state_file"
        exit 1
    fi
}

toggle() {
    local host port
    notify_shell
    host="$(server_host)"
    port="${EASYTTS_PORT:-8765}"
    [[ -n "$host" ]] || host="127.0.0.1"
    curl --fail --silent --max-time 2 -H 'Content-Type: application/json' \
        --data '{"action":"toggle"}' "http://${host}:${port}/api/control" >/dev/null
}

forward_shortcut() {
    # Hyprland consumed this global bind, so playerctl is not an equivalent
    # fallback for browser tabs: Firefox can expose an idle MPRIS object while
    # the actual YouTube player only responds to its own key event.  Send the
    # original key straight to the focused window instead.
    local key="$1"
    case "$key" in
        F6|F8|XF86AudioPause|XF86AudioPlay) ;;
        *) return 2 ;;
    esac
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = '', key = '$key', window = 'activewindow' })" >/dev/null
}

media_toggle() {
    # TTS has priority only while it is audibly reading.  A paused, completed,
    # or generating TTS job must not claim the normal media key: let MPRIS
    # control the user's video/music player in those states.
    local current
    current="$(status 2>/dev/null || true)"
    if printf '%s' "$current" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("state") == "playing")' 2>/dev/null | grep -qx True; then
        toggle
        return
    fi

    # Firefox can expose several simultaneous MPRIS sessions.  The default
    # playerctl target is arbitrary (and was selecting a paused tab instead
    # of the YouTube tab that was actually playing), so select deliberately:
    # pause a playing session first; otherwise resume a paused session.
    local wanted player state remembered
    # Always pause a currently playing session first.
    while IFS= read -r player; do
        state="$(playerctl --player="$player" status 2>/dev/null || true)"
        if [[ "$state" == "Playing" ]] && playerctl --player="$player" play-pause; then
            mkdir -p "$state_root"
            printf '%s\n' "$player" > "$media_player_file"
            return
        fi
    done < <(playerctl --list-all 2>/dev/null || true)

    # After pausing YouTube, resume that same session rather than whichever
    # unrelated Firefox tab happens to be listed first.
    remembered="$(cat "$media_player_file" 2>/dev/null || true)"
    if [[ -n "$remembered" ]] && [[ "$(playerctl --player="$remembered" status 2>/dev/null || true)" == "Paused" ]] && playerctl --player="$remembered" play-pause; then
        return
    fi

    # No remembered active session: resume any real paused media session.
    while IFS= read -r player; do
        state="$(playerctl --player="$player" status 2>/dev/null || true)"
        if [[ "$state" == "Paused" ]] && playerctl --player="$player" play-pause; then
            mkdir -p "$state_root"
            printf '%s\n' "$player" > "$media_player_file"
            return
        fi
    done < <(playerctl --list-all 2>/dev/null || true)

    forward_shortcut "${1:-F6}"
}

settings() {
    local provider="${1:-}" voice="${2:-}" rate="${3:-}" host port
    notify_shell
    host="$(server_host)"
    port="${EASYTTS_PORT:-8765}"
    [[ -n "$host" ]] || host="127.0.0.1"
    python3 -c 'import json, sys; print(json.dumps({"action": "settings", "provider": sys.argv[1], "voice": sys.argv[2], "rate": sys.argv[3]}))' "$provider" "$voice" "$rate" \
        | curl --fail --silent --max-time 2 -H 'Content-Type: application/json' --data-binary @- "http://${host}:${port}/api/control" >/dev/null
}

control() {
    local action="$1" value="${2:-}" host port
    notify_shell
    host="$(server_host)"
    port="${EASYTTS_PORT:-8765}"
    [[ -n "$host" ]] || host="127.0.0.1"
    python3 -c 'import json, sys; print(json.dumps({"action": sys.argv[1], **({"position": float(sys.argv[2])} if sys.argv[2] else {})}))' "$action" "$value" \
        | curl --fail --silent --max-time 2 -H 'Content-Type: application/json' --data-binary @- "http://${host}:${port}/api/control" >/dev/null
}

case "${1:-speak-clipboard}" in
    status) status ;;
    speak-clipboard) speak_clipboard "${2:-}" "${3:-}" "${4:-}" ;;
    settings) settings "${2:-}" "${3:-}" "${4:-}" ;;
    toggle) toggle ;;
    cancel) control cancel ;;
    media-toggle) media_toggle "${2:-F6}" ;;
    reset) control reset ;;
    seek) control seek "${2:-0}" ;;
    *) echo "usage: ttsctl {status|speak-clipboard [provider voice rate]|settings provider voice rate|toggle|cancel|media-toggle|reset|seek seconds}" >&2; exit 2 ;;
esac
