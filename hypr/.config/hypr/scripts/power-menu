#!/bin/sh

action="${1:-toggle}"

case "$action" in
    menu)
        action="toggle"
        ;;
    poweroff)
        action="shutdown"
        ;;
    restart)
        action="reboot"
        ;;
esac

case "$action" in
    lock)
        exec ~/.config/hypr/scripts/hyprlock-smart
        ;;
    suspend)
        if command -v hyprlock >/dev/null 2>&1 && ! pgrep -x hyprlock >/dev/null 2>&1; then
            ~/.config/hypr/scripts/hyprlock-smart >/dev/null 2>&1 &
            sleep 1
        fi
        exec systemctl suspend
        ;;
    toggle | open | close | logout | reboot | shutdown)
        exec qs ipc call powermenu "$action"
        ;;
    *)
        printf 'Usage: %s [toggle|open|close|lock|suspend|logout|reboot|shutdown]\n' "$0" >&2
        exit 2
        ;;
esac
