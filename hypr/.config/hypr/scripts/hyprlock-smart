#!/usr/bin/env bash

set -euo pipefail

base_config="${HYPRLOCK_CONFIG:-$HOME/.config/hypr/hyprlock.conf}"
preferred_external="${HYPRLOCK_EXTERNAL_MONITOR:-DP-1}"
laptop_monitor="${HYPRLOCK_LAPTOP_MONITOR:-eDP-1}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$runtime_dir/hypr" ]; then
    latest_instance="$(find "$runtime_dir/hypr" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | tail -1)"
    if [ -n "$latest_instance" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$latest_instance"
    fi
fi

monitor_json_raw="$(hyprctl monitors -j 2>/dev/null || true)"
if jq -e type >/dev/null 2>&1 <<<"$monitor_json_raw"; then
    monitor_json="$monitor_json_raw"
else
    monitor_json="[]"
fi

monitor_exists() {
    local name="$1"
    jq -e --arg name "$name" '.[] | select(.name == $name)' >/dev/null <<<"$monitor_json"
}

first_monitor() {
    jq -r '.[0].name // empty' <<<"$monitor_json"
}

if monitor_exists "$preferred_external"; then
    lock_monitor="$preferred_external"
elif monitor_exists "$laptop_monitor"; then
    lock_monitor="$laptop_monitor"
else
    lock_monitor="$(first_monitor)"
fi

if [ -z "${lock_monitor:-}" ]; then
    exec hyprlock --config "$base_config" "$@"
fi

tmp_dir="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/hyprlock-smart.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
runtime_config="$tmp_dir/hyprlock.conf"

sed \
    -e "s/^\$lockMonitor = .*/\$lockMonitor = ${lock_monitor}/" \
    -e "s/^\([[:space:]]*monitor = \)\$lockMonitor/\1${lock_monitor}/" \
    "$base_config" > "$runtime_config"

if [ "${HYPRLOCK_SMART_PRINT_CONFIG:-0}" = "1" ]; then
    cat "$runtime_config"
    exit 0
fi

hyprlock --config "$runtime_config" "$@"
